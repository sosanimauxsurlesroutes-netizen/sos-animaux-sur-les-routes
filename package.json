{
  "name": "sos-animaux-sur-les-routes-android",
  "version": "7.15.2",
  "private": true,
  "description": "Application Android SOS Animaux sur les Routes via Capacitor",
  "scripts": {
    "android:init": "npx cap add android",
    "android:sync": "npx cap sync android",
    "android:patch": "node scripts/patch-android.mjs",
    "android:prepare": "npm run android:sync && npm run android:patch",
    "android:open": "npx cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/app": "^8.0.0",
    "@capacitor/browser": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/geolocation": "^8.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0"
  }
}
